# Fichier réel attendu sur le VPS : backend/.env (non committé — voir .gitignore)
# Utilisé à la fois pour la substitution de variables dans docker-compose.prod.yml
# (${POSTGRES_USER} etc.) et comme env_file du service "api".

NODE_ENV=production
PORT=3000

# Postgres (conteneur dédié, non exposé à l'extérieur du VPS)
POSTGRES_USER=soga_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=soga_db

JWT_SECRET=change-me-min-32-chars-random-secret
JWT_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

ALLOWED_ORIGINS=https://sogasenegal.com,https://www.sogasenegal.com
